# ---------------------------------------------------------------------------
# מסד נתונים — PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL הוא מה שהאפליקציה משתמשת בו. אצל ספקים עם connection pooler
# (Neon, Supabase) זו כתובת ה-pooler.
DATABASE_URL="postgresql://user:password@host:5432/flyapp?schema=public"

# DIRECT_DATABASE_URL הוא חיבור ישיר בלי pooler, ומשמש רק להרצת מיגרציות.
# אצל ספק בלי pooler אפשר לשים כאן בדיוק את אותה כתובת.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/flyapp?schema=public"

# ---------------------------------------------------------------------------
# כניסה למערכת
# ---------------------------------------------------------------------------
# סיסמה משותפת לשני הסוכנים. אין משתמשים ואין הרשאות — יש מנעול אחד.
# בלי זה האפליקציה לא עולה: היא מחזיקה מספרי דרכון ולא תרוץ בלי הגנה.
APP_PASSCODE=""

# מפתח לחתימת עוגיית ההתחברות (32 בתים ב-base64).
# ליצירה: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# הצפנת מספרי דרכון
# ---------------------------------------------------------------------------
# 32 בתים ב-base64. אותה פקודה כמו למעלה.
# שינוי המפתח הזה הופך מספרי דרכון קיימים לבלתי קריאים.
PASSPORT_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# ה-job היומי
# ---------------------------------------------------------------------------
# טוקן שה-cron שולח ב-Authorization כדי להריץ POST /api/jobs/daily.
DAILY_JOB_TOKEN=""

# ---------------------------------------------------------------------------
# פרטי העסק — נכנסים לתוך ההודעות ללקוחות
# ---------------------------------------------------------------------------
# החתימה בתחתית כל הודעה.
AGENT_NAME=""

# שם העסק, לשימוש בתבניות שמזכירות אותו.
AGENCY_NAME=""

# המספר שנשלח ללקוח בהודעת היציאה, לכל דבר דחוף בזמן הנסיעה.
AGENT_EMERGENCY_PHONE=""
