# מסד נתונים. לפיתוח מקומי SQLite מספיק; בפרודקשן אפשר להחליף ל-Postgres.
DATABASE_URL="file:./dev.db"

# מפתח הצפנה למספרי דרכון (32 בתים ב-base64).
# ליצירה: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSPORT_ENCRYPTION_KEY=""

# טוקן להרצת ה-job היומי דרך HTTP (cron חיצוני).
DAILY_JOB_TOKEN="change-me"
