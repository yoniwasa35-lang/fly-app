// מודל הנתונים — סעיף 5 באפיון.
// PostgreSQL. ערכי enum נשמרים כמחרוזות ומאולצים בשכבת TypeScript
// (src/lib/domain/types.ts) ובוולידציית zod בכניסה למערכת — לא כ-enum של
// המסד, כדי שהוספת סוג רכיב או מצב אבן דרך לא תדרוש מיגרציה.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // חיבור ישיר, בלי pooler — נדרש למיגרציות מול Neon ודומיו.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Client {
  id     String  @id @default(cuid())
  name   String
  phone  String
  email  String?
  notes  String?

  /*
   * הרכב הנוסעים הקבוע של הלקוח: יחיד, זוג, משפחה או קבוצה.
   *
   * זו ברירת מחדל ברמת הלקוח ולא אמת ברמת הנסיעה — משפחה נוסעת לפעמים
   * בלי הילדים. הנוסעים בפועל של כל נסיעה יושבים ב-Traveler, וההרכב כאן
   * משמש כדי למלא את הנסיעה הבאה מראש במקום לשאול כל פעם מחדש.
   */
  partyType String @default("couple") // solo | couple | family | group
  adults    Int    @default(2)
  children  Int    @default(0)
  infants   Int    @default(0)
  /** גילאי הילדים, כמערך JSON. משפיע על מחיר ועל דרישות מושב ברכב. */
  childAges String?

  createdAt DateTime @default(now())
  trips     Trip[]
}

model Trip {
  id       String @id @default(cuid())
  code     String @unique // מספר תיק לתצוגה, למשל 2609-114
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  destination String // יעד ראשי, טקסט חופשי
  templateId  String // תבנית אבני הדרך — סעיף 7

  // העוגן הראשי. departureAt נשמר ב-UTC, ולצידו השעה המקומית ואזור הזמן של השדה
  // שממנו היא נגזרה. ראו סעיף 6.2 — זו המלכודת המרכזית של המערכת.
  departureAt      DateTime
  departureLocal   String // "YYYY-MM-DDTHH:mm" בשעון השדה
  departureTz      String // IANA, למשל Asia/Jerusalem
  departureAirport String // IATA

  returnAt      DateTime
  returnLocal   String
  returnTz      String
  returnAirport String

  // תבנית ב׳ (אירוע ספורט) — העוגן הוא האירוע ולא הטיסה.
  eventAt    DateTime?
  eventLocal String?
  eventTz    String?

  bookedAt DateTime @default(now()) // עוגן booking
  status   String   @default("active") // draft | active | traveling | returned | closed

  priceToClient Float @default(0)
  amountPaid    Float @default(0) // נדרש לסגירה אוטומטית של "גביית יתרה" — סעיף 6.3

  // הסוכנים מתמחרים מעל עלות הספק ומרוויחים את ההפרש, ולכן הרווח אינו שדה
  // אלא חישוב. שמירת "עמלה" בנפרד הייתה יוצרת מקור אמת שני שמתפצל מהראשון.
  // מה שכן משתנה הוא העלות: הספק מוסיף חיוב, רכיב מבוטל, שער מטבע זז —
  // ולכן יש עלות משוערת בהזמנה ועלות בפועל שנסגרת אחרי החזרה (סעיף 7א).
  supplierCost       Float  @default(0) // משוערת, בעת ההזמנה
  actualSupplierCost Float? // בפועל. null = עדיין לא נסגר

  // הסוכנות המארחת גובה נתח מההפרש. השיעור נשמר על התיק ולא כקבוע גלובלי,
  // כדי ששינוי בהסכם מול הסוכנות לא ישכתב רטרואקטיבית את הנתונים של עונה
  // שכבר נסגרה.
  hostFeeRate Float @default(0.01)

  source String? // המלצה, פרסום, לקוח חוזר
  notes  String?

  // עמוד הלקוח (סעיף 8.4) יושב על URL פתוח, בלי התחברות — הקישור עצמו הוא
  // הסוד. לכן הטוקן אקראי קריפטוגרפית ולא נגזר מה-id, וניתן להחלפה אם
  // הלקוח העביר את הקישור הלאה.
  publicToken String @unique

  /*
   * תמונת הקאבר של היעד בעמוד הלקוח. נשמרת ככתובת ולא כקובץ, ועם שורת
   * הקרדיט שלה — רישיון Unsplash מחייב ייחוס, ותמונה בלי קרדיט היא הפרה.
   * ריק הוא מצב תקין: העמוד נופל לרקע מדורג ולא לתמונה שבורה.
   */
  coverImageUrl String?
  coverCredit   String?

  travelers  Traveler[]
  components Component[]
  milestones Milestone[]
  documents  TripDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, departureAt])
  @@index([departureAt])
}

model Traveler {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  firstNameLatin String // בדיוק כמו בדרכון
  lastNameLatin  String
  displayNameHe  String?
  dateOfBirth    DateTime?

  // מספר הדרכון מוצפן במנוחה (AES-256-GCM) ונמחק בסגירת התיק — סעיף 10.
  passportNumberEnc String?
  passportLast4     String? // לזיהוי מהיר בלי פענוח
  passportExpiry    DateTime?
  passportCountry   String?

  phone  String?
  isLead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}

model Component {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  type        String // flight | hotel | transfer | car | insurance | activity | event_ticket | other
  supplier    String?
  reference   String? // PNR, מספר הזמנה
  description String?
  status      String  @default("requested") // requested | confirmed | cancelled | declined_by_client

  // שני הדדליינים החשובים ביותר במערכת. כל אחד מייצר אבן דרך אוטומטית.
  freeCancelUntil    DateTime?
  supplierPaymentDue DateTime?

  cost  Float @default(0)
  price Float @default(0)

  isUpsell       Boolean   @default(false)
  clientResponse String? // accepted | declined | no_answer
  declinedAt     DateTime? // תיעוד סירוב — הגנה משפטית

  sortOrder Int     @default(0)
  flight    Flight?
  stay      Stay?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([freeCancelUntil])
  @@index([supplierPaymentDue])
}

model Flight {
  componentId String    @id
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  airlineCode  String // IATA, למשל LY, A3, W6
  flightNumber String
  direction    String // outbound | inbound

  // שעה מקומית בשדה + אזור הזמן שלו. ה-UTC נגזר מהם ולא להפך.
  departsAtLocal String
  departsTz      String
  departsAirport String
  departsAtUtc   DateTime
  // שעת הנחיתה אינה תמיד ידועה בזמן פתיחת התיק. היא nullable בכוונה:
  // עדיף שדה ריק מאשר להעתיק לתוכו את שעת ההמראה, כי הערך הזה מוצג ללקוח.
  arrivesAtLocal String?
  arrivesTz      String
  arrivesAirport String
  arrivesAtUtc   DateTime?

  // מחושבים מטבלת הכללים לפי חברת תעופה, ניתנים לדריסה ידנית.
  checkinOpensAt    DateTime?
  checkinClosesAt   DateTime?
  checkinOverridden Boolean   @default(false)
  checkinDone       Boolean   @default(false)
  checkinDoneAt     DateTime?

  baggageAllowance String?

  updatedAt DateTime @updatedAt
}

model Milestone {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  key      String // מזהה סוג, למשל send_documents, checkin_closes
  title    String
  audience String // agent | client | both

  anchor        String // booking | departure | return | event | component_deadline | flight_outbound | flight_inbound | absolute
  anchorRef     String? // componentId כשהעוגן הוא רכיב
  anchorField   String? // checkin_opens_at | checkin_closes_at | free_cancel_until | supplier_payment_due
  offsetMinutes Int     @default(0) // היסט חתום מהעוגן. שלילי = לפני
  leadMinutes   Int     @default(0) // חלון ההתראה: pending→due כך וכך לפני המועד

  dueAt DateTime // מחושב, נשמר ב-UTC
  state String   @default("pending") // pending | due | overdue | blocked | done | skipped

  blockRulesJson   String? // כללי החסימה מהתבנית
  blockedByJson    String? // מה חוסם בפועל, כפי שחושב לאחרונה — לתצוגה
  autoCompleteRule String?

  skipReason   String?
  completedAt  DateTime?
  snoozedUntil DateTime?
  snoozeReason String?
  resolution   String? // לאבני דרך שדורשות בחירה מפורשת, למשל ביטוח

  messageTemplateKey String?
  isAutoGenerated    Boolean @default(true)
  bornLate           Boolean @default(false) // נולדה כבר באיחור — סעיף 14
  sortHint           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, key])
  @@index([state, dueAt])
  @@index([dueAt])
  @@index([tripId, dueAt])
}

/// דריסה של תבנית הודעה. ברירת המחדל חיה כקובץ ב-config/messages,
/// וכאן נשמר רק מה שהסוכן ערך בעצמו — סעיף 9 דורש את שניהם.
model MessageTemplate {
  key       String   @id
  body      String
  updatedAt DateTime @updatedAt
}

/// האטה על ניסיונות כניסה כושלים. נשמרת במסד ולא בזיכרון התהליך: בפריסה
/// ללא שרת כל instance מקבל זיכרון משלו, כך שתוקף שפוגע במספיק instances
/// מקבל את מלוא הניסיונות בכל אחד מהם. זה המנעול היחיד שמגן על פרטי
/// הלקוחות, ולכן הוא צריך להיות משותף.
model LoginAttempt {
  key          String    @id
  failures     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

/**
 * צ׳ק-ליסט המסמכים של הנסיעה.
 *
 * זו לא ספריית קבצים — הקבצים עצמם עוד לא נשמרים בשום מקום, ולכן אין
 * כאן שדה קובץ שהיה מתחזה לתמיכה שאינה קיימת. מה שכן יש הוא התשובה
 * לשאלה היחידה שהסוכן שואל לפני יציאה: "מה כבר שלחנו ומה עוד לא".
 *
 * המצבים מסודרים בשרשרת: חסר → התקבל מהספק → נשלח ללקוח. רק "נשלח"
 * נחשב מוכן, כי מסמך שיושב אצל הסוכן לא עוזר למי שעומד בשדה.
 */
model TripDocument {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  kind  String // flight_tickets | hotel_voucher | transfers | activities | insurance
  state String @default("missing") // missing | received | sent

  note       String?
  receivedAt DateTime?
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, kind])
  @@index([tripId])
}

/**
 * פרטי השהייה — הרחבה של רכיב מסוג מלון, באותה תבנית של Flight.
 *
 * רוב השדות מוזנים בידי הסוכן. מה שמגיע מ-Google Places מסומן ככזה,
 * ושני כללים חלים עליו:
 *
 *   1. אין להמציא כתובת אתר. officialUrl נשאר ריק עד שמישהו הזין אותו
 *      או עד שספק אמין החזיר אותו, ו-officialUrlSource אומר מי מהשניים.
 *      כתובת מומצאת בעמוד שהלקוח פותח היא נזק ממשי, לא אי-נוחות.
 *
 *   2. תמונות של Places לא נשמרות אצלנו — רישיון השירות אוסר זאת.
 *      נשמרות רק ההפניות, עם חותמת זמן, והן נמשכות מחדש כשהן מתיישנות.
 */
model Stay {
  componentId String    @id
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  name String

  // --- מה שהסוכן מזין ---
  roomType     String?
  boardBasis   String? // room_only | breakfast | half_board | full_board | all_inclusive
  checkInTime  String? // "HH:MM" בשעון המלון
  checkOutTime String?
  officialUrl       String?
  officialUrlSource String  @default("manual") // manual | places
  /** קישור לוואוצ׳ר שהספק סיפק. המערכת לא מאחסנת קבצים. */
  voucherUrl String?

  // --- מה שמגיע מ-Google Places ---
  placeId     String?
  address     String?
  lat         Float?
  lng         Float?
  rating      Float?
  ratingCount Int?
  stars       Int?
  /** הפניות תמונה בלבד, לא קבצים. ריק עד שמוגדר מפתח. */
  photosJson     String?
  photosCachedAt DateTime?

  updatedAt DateTime @updatedAt
}
